<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Fortnite Esports Performance Analyzer</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Orbitron:wght@600;800;900&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/styles.css">
</head>
<body class="dashboard-body text-light min-vh-100 d-flex flex-column">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark-slate border-bottom border-secondary border-opacity-25 sticky-top px-3 py-2">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-cyan font-orbitron fs-5" asp-controller="Home" asp-action="Index">
                <i class="bi bi-crosshair2 text-cyan me-2"></i>FORTNITE ANALYZER
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMain">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active text-cyan fw-bold" : "")" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Analytics" ? "active text-cyan fw-bold" : "")" asp-controller="Analytics" asp-action="Index">
                                <i class="bi bi-graph-up-arrow me-1"></i>Analytics
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Matches" ? "active text-cyan fw-bold" : "")" asp-controller="Matches" asp-action="Index">
                                <i class="bi bi-controller me-1"></i>Matches
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Coaching" ? "active text-cyan fw-bold" : "")" asp-controller="Coaching" asp-action="Index">
                                <i class="bi bi-cpu me-1"></i>AI Coaching
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Profile" ? "active text-cyan fw-bold" : "")" asp-controller="Profile" asp-action="Index">
                                <i class="bi bi-person-circle me-1"></i>Profile
                            </a>
                        </li>
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 text-warning @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active fw-bold" : "")" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-lock me-1"></i>Admin Panel
                                </a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-muted small">
                            <strong class="text-white">@User.Identity!.Name</strong>
                            <span class="badge bg-dark border border-secondary text-cyan ms-1">
                                @(User.IsInRole("Administrator") ? "Admin" : "Player")
                            </span>
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-box-arrow-right me-1"></i>Logout
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="navbar-nav ms-auto gap-2">
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="btn btn-cyan btn-sm text-dark fw-bold" asp-controller="Account" asp-action="Register">Get Started</a>
                    </div>
                }
            </div>
        </div>
    </nav>

    <main class="flex-grow-1">
        @if (TempData["Success"] is string successMsg)
        {
            <div class="container pt-3">
                <div class="alert alert-success alert-dismissible fade show border-0 shadow" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@successMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] is string errorMsg)
        {
            <div class="container pt-3">
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer bg-dark-slate border-top border-secondary border-opacity-25 py-3 mt-auto">
        <div class="container text-center text-muted small">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    &copy; 2026 <strong>AI Esports Performance Analyzer</strong>. Powered by ASP.NET Core 8 MVC.
                </div>
                <div class="d-flex gap-3">
                    <a href="/health" class="text-muted text-decoration-none"><i class="bi bi-activity text-success me-1"></i>System Status</a>
                    <span class="text-secondary">|</span>
                    <span class="text-muted">Fortnite-API.com Integration</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
