@model FortniteDashboard.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Player Dashboard";
}

<div class="container py-4">

    @* ---------- Profile & Sync Header ---------- *@
    <div class="profile-banner p-4 mb-4 rounded-3 bg-dark-slate border border-secondary border-opacity-25 d-flex flex-wrap align-items-center justify-content-between gap-3 shadow-sm">
        <div class="d-flex align-items-center gap-3">
            <div class="avatar-box rounded-circle bg-dark border border-cyan p-3 d-flex align-items-center justify-content-center" style="width:60px; height:60px;">
                <i class="bi bi-controller fs-2 text-cyan"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h3 class="gamer-tag font-orbitron mb-0 text-cyan fw-bold">@Model.FortniteUsername</h3>
                    <span class="badge bg-dark border border-secondary text-muted">@Model.PreferredGameMode</span>
                </div>
                <span class="text-muted small">@Model.PlayerName</span>
                @if (!string.IsNullOrWhiteSpace(Model.Team))
                {
                    <span class="badge bg-purple ms-2">@Model.Team</span>
                }
            </div>
        </div>

        <div class="d-flex align-items-center gap-4 flex-wrap">
            <div class="text-center px-3 border-end border-secondary border-opacity-25">
                <span class="text-muted small d-block font-orbitron">PERFORMANCE SCORE</span>
                <div class="d-flex align-items-center gap-2 justify-content-center">
                    <span class="display-6 font-orbitron fw-bold text-cyan">@Model.PerformanceScore.ToString("0.0")</span>
                    <span class="badge bg-cyan text-dark font-orbitron">@Model.PerformanceLevel</span>
                </div>
            </div>

            <div>
                <div class="text-muted small mb-1 text-end">
                    Last synced:
                    @(Model.Stats is not null ? Model.Stats.RecordedAt.ToLocalTime().ToString("MMM d, HH:mm") : "Never")
                </div>
                <form asp-controller="Dashboard" asp-action="SyncStats" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="text" name="username" class="form-control form-control-sm bg-dark text-light border-secondary"
                           placeholder="Epic username" value="@Model.FortniteUsername" required style="max-width: 180px;" />
                    <button type="submit" class="btn btn-cyan btn-sm font-orbitron fw-bold text-dark">
                        <i class="bi bi-arrow-repeat me-1"></i>Sync Stats
                    </button>
                </form>
            </div>
        </div>
    </div>

    @if (!Model.HasStats)
    {
        <div class="stat-card p-5 text-center text-muted border border-secondary border-opacity-25 rounded-3">
            <i class="bi bi-info-circle fs-1 text-cyan mb-3 d-block"></i>
            <h4 class="font-orbitron text-light">No Match Telemetry Found</h4>
            <p class="col-md-6 mx-auto">Enter your Epic Games username in the box above and click <strong>Sync Stats</strong> to pull your live match statistics from Fortnite API.</p>
        </div>
    }
    else
    {
        @* ---------- KPI Cards ---------- *@
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card p-3 text-center rounded-3 bg-dark-slate border border-secondary border-opacity-25">
                    <span class="text-muted small font-orbitron d-block">ELIMINATIONS</span>
                    <h3 class="text-cyan font-orbitron mb-0 fw-bold">@Model.Stats!.Eliminations</h3>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card p-3 text-center rounded-3 bg-dark-slate border border-secondary border-opacity-25">
                    <span class="text-muted small font-orbitron d-block">WINS</span>
                    <h3 class="text-purple font-orbitron mb-0 fw-bold">@Model.Stats.Wins</h3>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card p-3 text-center rounded-3 bg-dark-slate border border-secondary border-opacity-25">
                    <span class="text-muted small font-orbitron d-block">MATCHES PLAYED</span>
                    <h3 class="text-light font-orbitron mb-0 fw-bold">@Model.Stats.MatchesPlayed</h3>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card p-3 text-center rounded-3 bg-dark-slate border border-secondary border-opacity-25">
                    <span class="text-muted small font-orbitron d-block">DEATHS</span>
                    <h3 class="text-danger font-orbitron mb-0 fw-bold">@Model.Stats.Deaths</h3>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card p-3 text-center rounded-3 bg-dark-slate border border-secondary border-opacity-25">
                    <span class="text-muted small font-orbitron d-block">K/D RATIO</span>
                    <h3 class="text-pink font-orbitron mb-0 fw-bold">@Model.Stats.KDRatio.ToString("0.00")</h3>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card p-3 text-center rounded-3 bg-dark-slate border border-secondary border-opacity-25">
                    <span class="text-muted small font-orbitron d-block">WIN RATE</span>
                    <h3 class="text-cyan font-orbitron mb-0 fw-bold">@Model.Stats.WinRate.ToString("0.0")%</h3>
                </div>
            </div>
        </div>

        @* ---------- Recent Performance Trend Indicators ---------- *@
        <div class="stat-card p-3 mb-4 rounded-3 bg-dark-slate border border-secondary border-opacity-25">
            <h6 class="font-orbitron text-cyan mb-3"><i class="bi bi-activity me-2"></i>Recent Form &amp; Performance Indicators</h6>
            <div class="row g-3 text-center">
                <div class="col-6 col-md-3">
                    <div class="p-2 rounded bg-dark border border-secondary border-opacity-25">
                        <span class="text-muted small d-block">Recent K/D (Last 5)</span>
                        <span class="fs-5 fw-bold font-orbitron me-1">@Model.RecentForm.RecentKD.ToString("0.00")</span>
                        @if (Model.RecentForm.KDTrend == "up")
                        {
                            <span class="text-success"><i class="bi bi-arrow-up-right-circle-fill"></i></span>
                        }
                        else if (Model.RecentForm.KDTrend == "down")
                        {
                            <span class="text-danger"><i class="bi bi-arrow-down-right-circle-fill"></i></span>
                        }
                        else
                        {
                            <span class="text-muted"><i class="bi bi-dash-circle-fill"></i></span>
                        }
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-2 rounded bg-dark border border-secondary border-opacity-25">
                        <span class="text-muted small d-block">Recent Win Rate</span>
                        <span class="fs-5 fw-bold font-orbitron me-1">@Model.RecentForm.RecentWinRate.ToString("0.0")%</span>
                        @if (Model.RecentForm.WinRateTrend == "up")
                        {
                            <span class="text-success"><i class="bi bi-arrow-up-right-circle-fill"></i></span>
                        }
                        else if (Model.RecentForm.WinRateTrend == "down")
                        {
                            <span class="text-danger"><i class="bi bi-arrow-down-right-circle-fill"></i></span>
                        }
                        else
                        {
                            <span class="text-muted"><i class="bi bi-dash-circle-fill"></i></span>
                        }
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-2 rounded bg-dark border border-secondary border-opacity-25">
                        <span class="text-muted small d-block">Avg Placement</span>
                        <span class="fs-5 fw-bold font-orbitron me-1">#@Model.RecentForm.RecentAvgPlacement.ToString("0.0")</span>
                        @if (Model.RecentForm.PlacementTrend == "up")
                        {
                            <span class="text-success"><i class="bi bi-arrow-up-right-circle-fill"></i></span>
                        }
                        else if (Model.RecentForm.PlacementTrend == "down")
                        {
                            <span class="text-danger"><i class="bi bi-arrow-down-right-circle-fill"></i></span>
                        }
                        else
                        {
                            <span class="text-muted"><i class="bi bi-dash-circle-fill"></i></span>
                        }
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-2 rounded bg-dark border border-secondary border-opacity-25">
                        <span class="text-muted small d-block">Shot Accuracy</span>
                        <span class="fs-5 fw-bold font-orbitron me-1">@(Model.RecentForm.RecentAccuracy > 0 ? Model.RecentForm.RecentAccuracy.ToString("0.0") + "%" : "N/A")</span>
                    </div>
                </div>
            </div>
        </div>

        @* ---------- Charts & AI Coaching Section ---------- *@
        <div class="row g-3 mb-4">
            <div class="col-lg-8">
                <div class="stat-card p-3 rounded-3 bg-dark-slate border border-secondary border-opacity-25 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="font-orbitron text-cyan mb-0"><i class="bi bi-graph-up me-2"></i>K/D &amp; Win Rate Progression</h6>
                        <span class="badge bg-dark border border-secondary text-muted">Last @Model.History.Count Sync Snapshots</span>
                    </div>
                    <div class="chart-container" style="position: relative; height: 260px;">
                        <canvas id="trendChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="stat-card p-3 rounded-3 bg-dark-slate border border-cyan border-opacity-25 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="font-orbitron text-cyan mb-0"><i class="bi bi-cpu me-2"></i>AI Coaching Drills</h6>
                        <a asp-controller="Coaching" asp-action="Index" class="btn btn-outline-cyan btn-xs">View All</a>
                    </div>
                    @if (Model.Recommendations.Count == 0)
                    {
                        <p class="text-muted small mb-0">No coaching insights generated yet.</p>
                    }
                    else
                    {
                        foreach (var rec in Model.Recommendations.Take(3))
                        {
                            <div class="p-2 mb-2 rounded bg-dark border-start border-3 @(rec.Severity == "High" ? "border-danger" : "border-cyan")">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-secondary text-dark font-orbitron" style="font-size: 0.65rem;">@rec.Category</span>
                                    <span class="badge @(rec.Severity == "High" ? "bg-danger" : "bg-info text-dark")" style="font-size: 0.65rem;">@rec.Severity</span>
                                </div>
                                <p class="mb-1 small text-light fw-medium">@rec.RecommendationText</p>
                                @if (!string.IsNullOrWhiteSpace(rec.RecommendedAction))
                                {
                                    <span class="text-cyan small d-block"><i class="bi bi-arrow-right-short"></i>@rec.RecommendedAction</span>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        @* ---------- Recent Matches Table ---------- *@
        <div class="stat-card p-3 rounded-3 bg-dark-slate border border-secondary border-opacity-25">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="font-orbitron text-cyan mb-0"><i class="bi bi-list-stars me-2"></i>Recent Match History</h6>
                <a asp-controller="Matches" asp-action="Index" class="btn btn-outline-light btn-sm">Full Match History</a>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0 text-center">
                    <thead class="table-secondary text-uppercase small">
                        <tr>
                            <th>Date</th>
                            <th>Game Mode</th>
                            <th>Placement</th>
                            <th>Eliminations</th>
                            <th>Damage</th>
                            <th>Accuracy</th>
                            <th>Result</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentMatches.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-muted py-3">No individual match records logged yet. Sync stats or add a match in the Matches section.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var match in Model.RecentMatches)
                            {
                                <tr>
                                    <td>@match.PlayedAt.ToLocalTime().ToString("MMM d, HH:mm")</td>
                                    <td><span class="badge bg-dark border border-secondary">@match.GameModeName</span></td>
                                    <td class="fw-bold font-orbitron text-cyan">#@match.Placement</td>
                                    <td>@match.Eliminations</td>
                                    <td>@match.DamageDealt</td>
                                    <td>@(match.Accuracy > 0 ? match.Accuracy.ToString("0.0") + "%" : "-")</td>
                                    <td>
                                        @if (match.IsWin)
                                        {
                                            <span class="badge bg-success font-orbitron"><i class="bi bi-trophy-fill me-1"></i>VICTORY</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">MATCH</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/dashboard-charts.js"></script>
    <script>
        window.dashboardChartData = {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels)),
            kd: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartKDSeries)),
            winRate: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartWinRateSeries))
        };
        initDashboardCharts(window.dashboardChartData);
    </script>
}
