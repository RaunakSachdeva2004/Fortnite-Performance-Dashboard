@model FortniteDashboard.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">

    @* ---------- Profile banner ---------- *@
    <div class="profile-banner p-4 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="position-relative">
                <div class="avatar-box d-flex align-items-center justify-content-center">
                    <i class="bi bi-person-fill fs-3 text-cyan"></i>
                </div>
                <span class="status-indicator online"></span>
            </div>
            <div>
                <h4 class="gamer-tag mb-0">@Model.FortniteUsername</h4>
                <span class="text-muted small">@Model.PlayerName</span>
                @if (!string.IsNullOrWhiteSpace(Model.Team))
                {
                    <span class="badge bg-unreal ms-2">@Model.Team</span>
                }
            </div>
        </div>

        <div class="text-md-end">
            <div class="text-muted small mb-1">
                Last synced:
                @(Model.Stats is not null
                    ? Model.Stats.RecordedAt.ToLocalTime().ToString("MMM d, yyyy HH:mm")
                    : "Never")
            </div>
            <form asp-controller="Dashboard" asp-action="SyncStats" method="post" class="d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="text" name="username" class="form-control form-control-sm bg-dark text-light border-secondary"
                       placeholder="Epic username" value="@Model.FortniteUsername" required style="max-width: 200px;" />
                <button type="submit" class="btn btn-cyan btn-sm">
                    <i class="bi bi-arrow-repeat me-1"></i>Sync Stats
                </button>
            </form>
        </div>
    </div>

    @if (!Model.HasStats)
    {
        <div class="stat-card p-4 text-center text-muted">
            <i class="bi bi-info-circle me-2"></i>
            No stats yet. Enter your Epic username above and click <strong>Sync Stats</strong> to pull your first snapshot from FortniteAPI.io.
        </div>
    }
    else
    {
        @* ---------- KPI cards ---------- *@
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card p-3 text-center">
                    <span class="text-muted d-block">ELIMINATIONS</span>
                    <h2 class="text-cyan mb-0">@Model.Stats!.Eliminations</h2>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card p-3 text-center">
                    <span class="text-muted d-block">WINS</span>
                    <h2 class="text-purple mb-0">@Model.Stats.Wins</h2>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card p-3 text-center">
                    <span class="text-muted d-block">MATCHES PLAYED</span>
                    <h2 class="mb-0">@Model.Stats.MatchesPlayed</h2>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card p-3 text-center">
                    <span class="text-muted d-block">DEATHS</span>
                    <h2 class="mb-0">@Model.Stats.Deaths</h2>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card p-3 text-center">
                    <span class="text-muted d-block">K/D RATIO</span>
                    <h2 class="text-pink mb-0">@Model.Stats.KDRatio.ToString("0.00")</h2>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card p-3 text-center">
                    <span class="text-muted d-block">WIN RATE</span>
                    <h2 class="text-cyan mb-0">@Model.Stats.WinRate.ToString("0.0")%</h2>
                </div>
            </div>
        </div>

        @if (Model.Stats.Accuracy > 0)
        {
            <div class="stat-card p-3 mb-4 d-inline-block">
                <span class="text-muted d-block">SHOT ACCURACY</span>
                <h4 class="mb-0">@Model.Stats.Accuracy.ToString("0.0")%</h4>
            </div>
        }

        <div class="row g-3 mb-4">
            @* ---------- Trend charts (real history, not mock data) ---------- *@
            <div class="col-lg-8">
                <div class="stat-card p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="hud-title mb-0">K/D &amp; Win Rate Trend</h6>
                        <span class="badge bg-dark">Last @Model.History.Count sync@(Model.History.Count == 1 ? "" : "s")</span>
                    </div>
                    @if (Model.History.Count < 2)
                    {
                        <p class="text-muted small mb-0">Sync a few more times to build up a trend line.</p>
                    }
                    else if (Model.History.Select(s => s.SyncedUsername).Distinct().Count() > 1)
                    {
                        <p class="text-warning small mb-2">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            This history mixes stats from multiple different usernames
                            (@string.Join(", ", Model.History.Select(s => s.SyncedUsername).Distinct())) —
                            the trend line below isn't one player's real progression. Sync the same
                            username repeatedly to see a meaningful trend.
                        </p>
                    }
                    <div class="chart-container">
                        <canvas id="trendChart"></canvas>
                    </div>
                </div>
            </div>

            @* ---------- AI coaching recommendations ---------- *@
            <div class="col-lg-4">
                <div class="ai-card p-3 h-100">
                    <h5 class="mb-3"><i class="bi bi-robot me-2"></i>Coaching Tips</h5>
                    <p class="text-muted small">
                        Rule-based coaching engine (not a trained AI model) — designed to be swapped for an ML/LLM-backed engine later.
                    </p>
                    @if (Model.Recommendations.Count == 0)
                    {
                        <p class="text-muted small mb-0">No recommendations yet.</p>
                    }
                    else
                    {
                        foreach (var rec in Model.Recommendations)
                        {
                            <div class="coaching-item rounded p-2 mb-2">
                                <p class="mb-0 small">@rec.RecommendationText</p>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        @* ---------- Recent sync history table ---------- *@
        <div class="stat-card p-3">
            <h6 class="hud-title mb-3">Recent Sync History</h6>
            <div class="table-responsive">
                <table class="table custom-table mb-0">
                    <thead>
                        <tr>
                            <th>Synced At</th>
                            <th>Username</th>
                            <th>Eliminations</th>
                            <th>Wins</th>
                            <th>Matches</th>
                            <th>K/D</th>
                            <th>Win Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var snap in Enumerable.Reverse(Model.History))
                        {
                            <tr>
                                <td>@snap.RecordedAt.ToLocalTime().ToString("MMM d, HH:mm")</td>
                                <td class="text-muted">@snap.SyncedUsername</td>
                                <td>@snap.Eliminations</td>
                                <td>@snap.Wins</td>
                                <td>@snap.MatchesPlayed</td>
                                <td>@snap.KDRatio.ToString("0.00")</td>
                                <td>@snap.WinRate.ToString("0.0")%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/dashboard-charts.js"></script>
    <script>
        // Real data serialized from the server-side view model — never fabricated
        // in JavaScript. If there's no history yet, these arrays are simply empty
        // and dashboard-charts.js renders an empty/placeholder chart.
        window.dashboardChartData = {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels)),
            kd: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartKDSeries)),
            winRate: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartWinRateSeries))
        };
        initDashboardCharts(window.dashboardChartData);
    </script>
}
