@{
    ViewData["Title"] = "Something went wrong";
}

<div class="container d-flex flex-column align-items-center justify-content-center text-center" style="min-height: 80vh;">
    <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
    <h3 class="fw-bold mt-3">Something went wrong</h3>
    <p class="text-muted">An unexpected error occurred. Please try again, and contact support if it keeps happening.</p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-cyan mt-2">Back to Dashboard</a>
</div>
