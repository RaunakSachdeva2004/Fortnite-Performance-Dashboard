@{
    ViewData["Title"] = "Server Error";
}

<div class="container d-flex flex-column align-items-center justify-content-center text-center py-5" style="min-height: 70vh;">
    <i class="bi bi-exclamation-octagon text-danger display-1 mb-3"></i>
    <h1 class="display-4 font-orbitron fw-bold text-danger">500 - SYSTEM ERROR</h1>
    <p class="text-muted col-md-6 mb-4">An unexpected system exception occurred while processing telemetry. The incident has been logged for system administrators.</p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-cyan font-orbitron fw-bold text-dark px-4 py-2">
        <i class="bi bi-arrow-left me-2"></i>Return to Dashboard
    </a>
</div>
