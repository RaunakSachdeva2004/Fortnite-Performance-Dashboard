@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container d-flex flex-column align-items-center justify-content-center text-center py-5" style="min-height: 70vh;">
    <i class="bi bi-compass text-cyan display-1 mb-3"></i>
    <h1 class="display-4 font-orbitron fw-bold text-cyan">404 - NOT FOUND</h1>
    <p class="text-muted col-md-6 mb-4">The telemetry page or match resource you were looking for does not exist or has been moved.</p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-cyan font-orbitron fw-bold text-dark px-4 py-2">
        <i class="bi bi-house me-2"></i>Return to Dashboard
    </a>
</div>
