@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Panel";
}

<div class="container py-4">

    <h3 class="fw-bold text-purple mb-4"><i class="bi bi-shield-shaded me-2"></i>ADMIN PANEL</h3>

    <div class="row g-3 text-center mb-4">
        <div class="col-6 col-md-3">
            <div class="card stat-card p-3 h-100">
                <span class="text-muted small fw-semibold">TOTAL PLAYERS</span>
                <h2 class="fw-bold text-white my-1">@Model.TotalPlayers</h2>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card p-3 h-100">
                <span class="text-muted small fw-semibold">TEAMS</span>
                <h2 class="fw-bold text-white my-1">@Model.TotalTeams</h2>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card p-3 h-100">
                <span class="text-muted small fw-semibold">AVG WIN RATE</span>
                <h2 class="fw-bold text-cyan my-1">@Model.AverageWinRate.ToString("0.0")%</h2>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card p-3 h-100">
                <span class="text-muted small fw-semibold">AVG K/D</span>
                <h2 class="fw-bold text-pink my-1">@Model.AverageKDRatio.ToString("0.00")</h2>
            </div>
        </div>
    </div>

    <div class="card stat-card p-4">
        <h5 class="fw-bold text-light mb-3"><i class="bi bi-people me-2 text-cyan"></i>Roster</h5>
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0 custom-table">
                <thead>
                    <tr class="text-muted small">
                        <th>PLAYER</th>
                        <th>EMAIL</th>
                        <th>TEAM</th>
                        <th>ELIMINATIONS</th>
                        <th>WINS</th>
                        <th>MATCHES</th>
                        <th>K/D</th>
                        <th>WIN RATE</th>
                        <th>LAST SYNCED</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Players)
                    {
                        <tr>
                            <td><strong class="text-white">@p.FortniteUsername</strong> <span class="text-muted small">(@p.UserName)</span></td>
                            <td class="text-muted small">@p.Email</td>
                            <td>@(p.Team ?? "-")</td>
                            <td>@p.Eliminations.ToString("N0")</td>
                            <td>@p.Wins.ToString("N0")</td>
                            <td>@p.MatchesPlayed.ToString("N0")</td>
                            <td class="text-pink fw-semibold">@p.KDRatio.ToString("0.00")</td>
                            <td class="text-cyan fw-semibold">@p.WinRate.ToString("0.0")%</td>
                            <td class="text-muted small">@(p.LastSyncedAt?.ToLocalTime().ToString("g") ?? "Never")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
