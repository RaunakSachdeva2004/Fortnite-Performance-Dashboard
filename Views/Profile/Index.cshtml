@model FortniteDashboard.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Player Profile";
}

<div class="container py-4">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="font-orbitron text-cyan fw-bold mb-1"><i class="bi bi-person-badge me-2"></i>PLAYER PROFILE</h2>
            <p class="text-muted small mb-0">Manage your player identity, team affiliation, and preferred game modes.</p>
        </div>
    </div>

    <div class="row g-4">
        @* ---------- Left Column: Identity Summary ---------- *@
        <div class="col-md-4">
            <div class="stat-card p-4 rounded-3 bg-dark-slate border border-secondary border-opacity-25 text-center h-100">
                <div class="avatar-box rounded-circle bg-dark border border-cyan p-4 d-inline-flex align-items-center justify-content-center mb-3" style="width:90px; height:90px;">
                    <i class="bi bi-person-fill display-4 text-cyan"></i>
                </div>
                <h3 class="font-orbitron text-cyan fw-bold mb-1">@Model.FortniteUsername</h3>
                <span class="text-muted d-block mb-2">@Model.Name</span>
                <span class="badge bg-dark border border-secondary text-cyan font-orbitron px-3 py-2 mb-3">@Model.Role</span>

                <hr class="border-secondary border-opacity-25" />

                <div class="text-start space-y-2 small text-muted">
                    <div class="d-flex justify-content-between py-1 border-bottom border-secondary border-opacity-25">
                        <span>Email:</span><strong class="text-light">@Model.Email</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom border-secondary border-opacity-25">
                        <span>Joined:</span><strong class="text-light">@Model.JoinedDate.ToLocalTime().ToString("MMM d, yyyy")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom border-secondary border-opacity-25">
                        <span>Total Matches:</span><strong class="text-light">@Model.TotalMatches</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span>Rating Score:</span><strong class="text-cyan font-orbitron">@Model.PerformanceScore.ToString("0.0") (@Model.PerformanceLevel)</strong>
                    </div>
                </div>
            </div>
        </div>

        @* ---------- Right Column: Editable Profile Form ---------- *@
        <div class="col-md-8">
            <div class="stat-card p-4 rounded-3 bg-dark-slate border border-secondary border-opacity-25 h-100">
                <h5 class="font-orbitron text-cyan mb-4"><i class="bi bi-gear me-2"></i>Edit Player Details</h5>
                <form asp-controller="Profile" asp-action="UpdateProfile" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Display Name</label>
                            <input type="text" name="Name" value="@Model.Name" class="form-control bg-dark text-light border-secondary" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Fortnite / Epic Username</label>
                            <input type="text" name="FortniteUsername" value="@Model.FortniteUsername" class="form-control bg-dark text-light border-secondary" readonly title="Linked to Epic Games API" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Esports Team / Clan</label>
                            <input type="text" name="Team" value="@Model.Team" class="form-control bg-dark text-light border-secondary" placeholder="e.g. FaZe Clan, Solo" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Preferred Game Mode</label>
                            <select name="PreferredGameMode" class="form-select bg-dark text-light border-secondary">
                                @foreach (var mode in Model.AvailableGameModes)
                                {
                                    <option value="@mode" selected="@(Model.PreferredGameMode == mode ? "selected" : null)">@mode</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-muted">Player Bio / Playstyle Summary</label>
                        <textarea name="Bio" class="form-control bg-dark text-light border-secondary" rows="3" placeholder="Brief description of your competitive playstyle...">@Model.Bio</textarea>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-cyan text-dark font-orbitron fw-bold px-4">Save Profile</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
