@model FortniteDashboard.ViewModels.AnalyticsViewModel
@{
    ViewData["Title"] = "Performance Analytics";
}

<div class="container py-4">

    @* ---------- Page Header & Time Window Selector ---------- *@
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="font-orbitron text-cyan fw-bold mb-1"><i class="bi bi-graph-up-arrow me-2"></i>PERFORMANCE ANALYTICS</h2>
            <p class="text-muted small mb-0">Detailed breakdown of combat efficiency, survival consistency, and historical trajectory for <strong>@Model.FortniteUsername</strong>.</p>
        </div>

        <div class="btn-group font-orbitron" role="group">
            <a asp-controller="Analytics" asp-action="Index" asp-route-period="7d" class="btn btn-sm @(Model.SelectedPeriod == "7d" ? "btn-cyan font-bold text-dark" : "btn-outline-secondary")">7 DAYS</a>
            <a asp-controller="Analytics" asp-action="Index" asp-route-period="30d" class="btn btn-sm @(Model.SelectedPeriod == "30d" ? "btn-cyan font-bold text-dark" : "btn-outline-secondary")">30 DAYS</a>
            <a asp-controller="Analytics" asp-action="Index" asp-route-period="90d" class="btn btn-sm @(Model.SelectedPeriod == "90d" ? "btn-cyan font-bold text-dark" : "btn-outline-secondary")">90 DAYS</a>
            <a asp-controller="Analytics" asp-action="Index" asp-route-period="all" class="btn btn-sm @(Model.SelectedPeriod == "all" ? "btn-cyan font-bold text-dark" : "btn-outline-secondary")">ALL TIME</a>
        </div>
    </div>

    @* ---------- Performance Score Gauge Card ---------- *@
    <div class="stat-card p-4 mb-4 rounded-3 bg-dark-slate border border-cyan border-opacity-25 shadow-sm">
        <div class="row align-items-center g-3">
            <div class="col-md-3 text-center border-end border-secondary border-opacity-25">
                <span class="text-muted small font-orbitron d-block">OVERALL PERFORMANCE SCORE</span>
                <span class="display-4 font-orbitron fw-extrabold text-cyan">@Model.OverallPerformanceScore.ToString("0.0")</span>
                <span class="badge bg-cyan text-dark font-orbitron d-block col-8 mx-auto mt-2">@Model.PerformanceLevel</span>
            </div>
            <div class="col-md-9">
                <div class="row text-center g-3">
                    <div class="col-6 col-md-3">
                        <span class="text-muted small d-block">Score Delta</span>
                        <span class="fs-5 font-orbitron @(Model.ScoreChange >= 0 ? "text-success" : "text-danger")">
                            @(Model.ScoreChange >= 0 ? "+" : "")@Model.ScoreChange.ToString("0.0")
                        </span>
                    </div>
                    <div class="col-6 col-md-3">
                        <span class="text-muted small d-block">Matches Analyzed</span>
                        <span class="fs-5 font-orbitron text-light">@Model.Consistency.MatchesPlayed</span>
                    </div>
                    <div class="col-6 col-md-3">
                        <span class="text-muted small d-block">Best Placement</span>
                        <span class="fs-5 font-orbitron text-cyan">#@Model.Consistency.BestPlacement</span>
                    </div>
                    <div class="col-6 col-md-3">
                        <span class="text-muted small d-block">Score Variance</span>
                        <span class="fs-5 font-orbitron text-purple">±@Model.Consistency.ScoreVariance.ToString("0.0")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ---------- Combat vs Survival Grid ---------- *@
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="stat-card p-4 rounded-3 bg-dark-slate border border-secondary border-opacity-25 h-100">
                <h5 class="font-orbitron text-pink mb-3"><i class="bi bi-crosshair me-2"></i>Combat Performance</h5>
                <div class="row g-3 text-center mb-3">
                    <div class="col-6">
                        <div class="p-3 bg-dark rounded border border-secondary border-opacity-25">
                            <span class="text-muted small d-block">K/D RATIO</span>
                            <span class="fs-3 font-orbitron text-pink fw-bold">@Model.Combat.KDRatio.ToString("0.00")</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-dark rounded border border-secondary border-opacity-25">
                            <span class="text-muted small d-block">TOTAL KILLS</span>
                            <span class="fs-3 font-orbitron text-light fw-bold">@Model.Combat.TotalEliminations</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-dark rounded border border-secondary border-opacity-25">
                            <span class="text-muted small d-block">AVG DAMAGE/MATCH</span>
                            <span class="fs-3 font-orbitron text-cyan fw-bold">@Model.Combat.AvgDamagePerMatch.ToString("0")</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-dark rounded border border-secondary border-opacity-25">
                            <span class="text-muted small d-block">ACCURACY</span>
                            <span class="fs-3 font-orbitron text-purple fw-bold">@(Model.Combat.Accuracy > 0 ? Model.Combat.Accuracy.ToString("0.0") + "%" : "N/A")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="stat-card p-4 rounded-3 bg-dark-slate border border-secondary border-opacity-25 h-100">
                <h5 class="font-orbitron text-cyan mb-3"><i class="bi bi-shield-shaded me-2"></i>Survival Performance</h5>
                <div class="row g-3 text-center mb-3">
                    <div class="col-6">
                        <div class="p-3 bg-dark rounded border border-secondary border-opacity-25">
                            <span class="text-muted small d-block">WIN RATE</span>
                            <span class="fs-3 font-orbitron text-cyan fw-bold">@Model.Survival.WinRate.ToString("0.0")%</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-dark rounded border border-secondary border-opacity-25">
                            <span class="text-muted small d-block">VICTORY ROYALES</span>
                            <span class="fs-3 font-orbitron text-purple fw-bold">@Model.Survival.TotalWins</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-dark rounded border border-secondary border-opacity-25">
                            <span class="text-muted small d-block">AVG PLACEMENT</span>
                            <span class="fs-3 font-orbitron text-light fw-bold">#@Model.Survival.AvgPlacement.ToString("0.0")</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-dark rounded border border-secondary border-opacity-25">
                            <span class="text-muted small d-block">TOP 10 FINISHES</span>
                            <span class="fs-3 font-orbitron text-pink fw-bold">@Model.Survival.Top10Placements</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ---------- Multi-Metric Analytics Chart ---------- *@
    <div class="stat-card p-4 rounded-3 bg-dark-slate border border-secondary border-opacity-25">
        <h5 class="font-orbitron text-cyan mb-3"><i class="bi bi-sliders me-2"></i>Multi-Metric Trend Analytics</h5>
        <div class="chart-container" style="position: relative; height: 320px;">
            <canvas id="analyticsChart"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const ctx = document.getElementById('analyticsChart')?.getContext('2d');
            if (!ctx) return;

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels)),
                    datasets: [
                        {
                            label: 'K/D Ratio',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.KDSeries)),
                            borderColor: '#06b6d4',
                            backgroundColor: 'rgba(6, 182, 212, 0.1)',
                            fill: true,
                            tension: 0.3,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Win Rate %',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WinRateSeries)),
                            borderColor: '#a855f7',
                            backgroundColor: 'rgba(168, 85, 247, 0.1)',
                            fill: false,
                            tension: 0.3,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { grid: { color: 'rgba(255,255,255,0.05)' } },
                        y: { position: 'left', grid: { color: 'rgba(255,255,255,0.05)' }, title: { display: true, text: 'K/D', color: '#06b6d4' } },
                        y1: { position: 'right', grid: { drawOnChartArea: false }, title: { display: true, text: 'Win Rate %', color: '#a855f7' } }
                    }
                }
            });
        });
    </script>
}
